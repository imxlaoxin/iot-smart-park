<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.imxiaoxin.iot.mapper.ParkSpotInfoMapper">

  <select id="countParkSpotStatus" resultType="com.imxiaoxin.iot.model.vo.statsParkSpotStatusVo">
    # 统计总车位数和空闲车位数
    select count(*) totalParkingCount, sum(if(status = 0, 1, 0)) freeParkingCount
    from park_spot_info
  </select>
</mapper>
